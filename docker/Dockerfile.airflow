FROM apache/airflow:2.9.2-python3.11

USER root
RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*
USER airflow

# Install the Postgres provider using Airflow's official constraints so it
# matches the versions Airflow 2.9.2 was tested against (avoids pin conflicts).
ARG AIRFLOW_VERSION=2.9.2
ARG PYTHON_VERSION=3.11
RUN pip install --no-cache-dir \
    "apache-airflow-providers-postgres" \
    --constraint "https://raw.githubusercontent.com/apache/airflow/constraints-${AIRFLOW_VERSION}/constraints-${PYTHON_VERSION}.txt"

# Install Great Expectations and ML libs WITHOUT exact pins so pip can resolve
# versions compatible with the Airflow install already in the image.
RUN pip install --no-cache-dir \
    "great-expectations>=1.3,<2" \
    "scikit-learn>=1.3" \
    "requests>=2.31"