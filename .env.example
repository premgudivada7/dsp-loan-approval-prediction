# Copy to .env and adjust as needed. Never commit real secrets.

# Application database (used by the API + prediction storage)
DATABASE_URL=postgresql+psycopg2://loan:loan@postgres:5432/loan

# Path the API loads the model from
MODEL_PATH=/app/model/model.pkl

# API base URL used by Streamlit and the prediction DAG
API_URL=http://api:8000

# Microsoft Teams Incoming Webhook for Data Quality Alerts.
# Leave empty to have alerts logged instead of posted.
TEAMS_WEBHOOK_URL=
